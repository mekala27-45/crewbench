FROM node:24.19.0-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY src ./src
COPY evaluation/plan.json evaluation/case-index.json ./evaluation/
COPY fixtures/runtime ./fixtures/runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=80
EXPOSE 80
CMD ["node", "src/api/server.ts"]
